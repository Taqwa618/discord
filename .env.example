# ============================================================
#  Шаблон настроек Discord-бота.
#  1) Скопируйте файл и переименуйте копию в ".env"
#  2) Заполните значения
#  ВАЖНО: файл .env НЕ загружайте на GitHub (он уже в .gitignore),
#  токен храните в переменных окружения на хостинге.
# ============================================================

# Токен бота — Discord Developer Portal -> ваше приложение -> Bot -> Reset Token
DISCORD_TOKEN=вставьте_сюда_токен

# Префикс команд (по умолчанию "!")
PREFIX=!

# Имя файла базы данных (необязательно, по умолчанию economy.db)
# DB_NAME=economy.db
